BOT_TOKEN=123456:ABC-your-token-from-BotFather
ADMIN_IDS=[111111111]

# адрес панели вместе с секретным путём (web base path), без слеша в конце
PANEL_URL=https://panel.example.com:2053/secretpath
# Настройки панели -> API-токены, нужен токен со scope admin
PANEL_API_TOKEN=change-me
PANEL_VERIFY_SSL=true

# id VLESS+Reality инбаунда в панели и адрес сервера для ссылок
INBOUND_ID=1
SERVER_HOST=vpn.example.com

DEFAULT_DAYS=30
REMIND_BEFORE_DAYS=3
